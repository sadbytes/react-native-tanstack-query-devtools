{
  "name": "react-native-tanstack-query-devtools-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "clean": "turbo run clean --filter=./packages/*",
    "dev": "turbo run dev --filter=react-native-tanstack-query-devtools-dashboard --filter=@react-native-tanstack-query-devtools/expo-crud-app",
    "test": "turbo run test --filter=react-native-tanstack-query-devtools-bridge --filter=react-native-tanstack-query-devtools-core",
    "typecheck": "turbo run typecheck --filter=./packages/* --filter=@react-native-tanstack-query-devtools/expo-crud-app"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "turbo": "^2.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
