{
  "name": "react-native-tanstack-query-devtools-dashboard",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadbytes/react-native-tanstack-query-devtools.git"
  },
  "homepage": "https://github.com/sadbytes/react-native-tanstack-query-devtools",
  "bugs": {
    "url": "https://github.com/sadbytes/react-native-tanstack-query-devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rn-tanstack-query-devtools": "./dist/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsup src/index.tsx --format esm --dts --external vite && vite build",
    "clean": "rimraf dist .dev",
    "dev": "tsup src/dev.ts --format esm --out-dir .dev --external vite --silent && node .dev/dev.js",
    "prepack": "pnpm run build",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/dashboard/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-native-tanstack-query-devtools-core": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.9.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.1.14"
  }
}
