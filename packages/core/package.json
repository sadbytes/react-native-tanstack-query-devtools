{
  "name": "react-native-tanstack-query-devtools-core",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadbytes/react-native-tanstack-query-devtools.git"
  },
  "homepage": "https://github.com/sadbytes/react-native-tanstack-query-devtools",
  "bugs": {
    "url": "https://github.com/sadbytes/react-native-tanstack-query-devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "prepack": "pnpm run build",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/core/test/protocol.test.ts packages/core/test/transport.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0"
  }
}
