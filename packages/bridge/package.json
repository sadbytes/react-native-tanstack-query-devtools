{
  "name": "react-native-tanstack-query-devtools-bridge",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadbytes/react-native-tanstack-query-devtools.git"
  },
  "homepage": "https://github.com/sadbytes/react-native-tanstack-query-devtools",
  "bugs": {
    "url": "https://github.com/sadbytes/react-native-tanstack-query-devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.js",
      "require": "./dist/production.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/production.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "prepack": "pnpm run build",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/bridge/test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-native-tanstack-query-devtools-core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "*"
  }
}
